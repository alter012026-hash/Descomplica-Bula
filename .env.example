# Copie para .env.local e preencha somente os serviços que utilizar.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obrigatório para proteger /admin. Use uma senha longa e exclusiva.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Chaves opcionais para geração de conteúdo (ao menos uma para gerar artigos).
GROK_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Newsletter (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEWSLETTER_CRON_SECRET=

# Persistência opcional das métricas de visitas (Upstash Redis).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Integração opcional do painel administrativo com GitHub/Vercel.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
VERCEL_DEPLOY_HOOK=

# IndexNow (opcional)
INDEXNOW_KEY=
