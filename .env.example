# Copie para .env.local no desenvolvimento. Em produção, cadastre variáveis
# no projeto Vercel; segredos nunca devem ser commitados no Git.
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obrigatórias para habilitar o login em /admin.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Configure ao menos um provedor para gerar rascunhos com IA. A mesma chave
# deve ser adicionada como GitHub Actions secret para a geração diária.
GROK_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Newsletter: Resend exige uma chave e um remetente verificado para envio real.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Mesmo valor na Vercel e no GitHub Actions secret.
NEWSLETTER_CRON_SECRET=

# Persistência opcional das métricas (Upstash Redis).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Integração opcional do painel administrativo com GitHub/Vercel.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
# Opcional: deploy hook adicional; pushes para main já implantam via integração Vercel-GitHub.
VERCEL_DEPLOY_HOOK=

# IndexNow (opcional)
INDEXNOW_KEY=
